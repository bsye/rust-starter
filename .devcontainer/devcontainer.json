{
  "name": "rust-starter",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "app",
  "workspaceFolder": "/app",
  "overrideCommand": false,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "DioxusLabs.dioxus", "tamasfe.even-better-toml"],
      "settings": {
        "rust-analyzer.cargo.features": ["server"],
        "rust-analyzer.cargo.targetDir": true,
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
